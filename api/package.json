{
  "name": "night-life-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate:local": "wrangler d1 migrations apply night_life_app --local",
    "db:migrate:remote": "wrangler d1 migrations apply night_life_app --remote",
    "db:schema:local": "wrangler d1 execute night_life_app --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
